---
import Navbar from '../components/Navbar';
import CardGenerator from '../components/CardGenerator';
import '../styles/globals.css';
---

<html lang="en" class="dark h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Studio — Stargazer</title>
    <meta name="description" content="Configure and export high-definition stargazer cards and 60fps MP4 videos." />
    <script is:inline>
      const savedTheme = localStorage.getItem('stargazer-theme') || 'dark';
      document.documentElement.classList[savedTheme === 'dark' ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="h-screen w-screen bg-background text-foreground flex flex-col font-sans overflow-hidden antialiased">
    <Navbar client:load showAction={false} />
    <div class="flex-1 w-full overflow-hidden h-[calc(100vh-3.5rem)]">
      <CardGenerator client:load />
    </div>
  </body>
</html>
