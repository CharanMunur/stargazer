---
import CardGenerator from '../components/CardGenerator';
import '../styles/globals.css';
---

<html lang="en" class="dark h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>generator studio — stargazer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300;1,9..40,400;1,9..40,500&display=swap" rel="stylesheet">
  </head>
  <body class="h-full bg-[#0F0E10] text-[#F5EDE7] flex flex-col font-sans overflow-hidden selection:bg-[#2A1B17] selection:text-[#F5EDE7] lowercase">
    {/* Studio Top Navigation Bar */}
    <header class="h-[65px] border-b border-[#342A27] bg-[#0F0E10]/95 backdrop-blur-xl shrink-0 z-50">
      <div class="h-full max-w-full px-6 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-xl bg-[#2A1B17] border border-[#342A27] flex items-center justify-center text-[#F2C879] shadow-sm group-hover:border-[#E87443] transition-colors">
            <svg class="w-4 h-4 fill-[#F2C879]" viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-[#F5EDE7] text-base tracking-tight lowercase">stargazer</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#18181B] border border-[#342A27] text-[#B8AAA3] lowercase">
              studio
            </span>
          </div>
        </a>

        <div class="flex items-center gap-4">
          <a href="/" class="text-xs font-medium text-[#B8AAA3] hover:text-[#F5EDE7] transition-colors flex items-center gap-1.5 lowercase">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            back to home
          </a>
        </div>
      </div>
    </header>

    {/* Studio App Shell */}
    <div class="flex-1 overflow-hidden">
      <CardGenerator client:load />
    </div>
  </body>
</html>
