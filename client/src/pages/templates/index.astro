---
import Navbar from '../../components/Navbar';
import TemplateDetail from '../../components/TemplateDetail';
import { templatesList } from '../../lib/templatesData';
import '../../styles/globals.css';

const template = templatesList[0];
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{template.name} Template — Stargazer</title>
    <meta name="description" content={template.summary} />
    <script is:inline>
      const savedTheme = localStorage.getItem('stargazer-theme') || 'dark';
      document.documentElement.classList[savedTheme === 'dark' ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased">
    <Navbar client:load showAction={false} />
    <div class="flex-1 w-full">
      <TemplateDetail client:load template={template} />
    </div>
    <footer class="border-t py-6 text-sm text-muted-foreground">
      <div class="px-6 flex items-center justify-between">
        <span>Stargazer</span>
        <div class="flex items-center gap-4">
          <a href="/templates" class="hover:text-foreground">Templates</a>
          <a href="/generate" class="hover:text-foreground">Studio</a>
          <a href="https://github.com/charanmunur/stargazer" target="_blank" rel="noreferrer" class="hover:text-foreground">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
