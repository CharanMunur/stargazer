---
import Layout from '../layouts/Layout.astro';
import TermsPage from '../components/pages/TermsPage';

const termsBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': 'https://stargazer.charanmunur.in/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Terms of Service',
      'item': 'https://stargazer.charanmunur.in/terms',
    },
  ],
};
---

<Layout
  title="Terms of Service — Stargazer"
  description="Stargazer Terms of Service. Open source MIT license, export ownership, acceptable use, and disclaimer of warranties."
  schema={termsBreadcrumbSchema}
>
  <TermsPage client:load />
</Layout>
