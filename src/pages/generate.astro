---
import Layout from '../layouts/Layout.astro';
import StudioPage from '../components/pages/StudioPage';

const generateBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': 'https://stargazer.charanmunur.in/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Studio',
      'item': 'https://stargazer.charanmunur.in/generate',
    },
  ],
};
---

<Layout
  title="Studio — Stargazer"
  description="Configure and export high-definition stargazer cards and 60fps MP4 videos directly in your browser."
  schema={generateBreadcrumbSchema}
>
  <StudioPage client:load />
</Layout>
