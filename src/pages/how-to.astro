---
import Layout from '../layouts/Layout.astro';
import HowToPage from '../components/pages/HowToPage';

const howToSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    'name': 'How to Generate GitHub Stargazer Cards and Videos',
    'description': 'Step-by-step guide to generating a GitHub Personal Access Token (PAT) and creating custom stargazer milestone cards and 60fps MP4 loops.',
    'image': 'https://stargazer.charanmunur.in/og-image.png',
    'totalTime': 'PT2M',
    'estimatedCost': {
      '@type': 'MonetaryAmount',
      'currency': 'USD',
      'value': '0',
    },
    'step': [
      {
        '@type': 'HowToStep',
        'name': 'Open Token Settings',
        'text': 'Navigate to your GitHub account settings under Developer Settings -> Personal Access Tokens.',
        'url': 'https://stargazer.charanmunur.in/how-to#open-token-settings',
      },
      {
        '@type': 'HowToStep',
        'name': 'Select Classic Token',
        'text': 'Choose Tokens (classic) and click Generate new token.',
        'url': 'https://stargazer.charanmunur.in/how-to#select-classic-token',
      },
      {
        '@type': 'HowToStep',
        'name': 'Select public_repo Scope',
        'text': 'Check the public_repo scope to grant access to public repository stargazers.',
        'url': 'https://stargazer.charanmunur.in/how-to#select-public-repo-scope',
      },
      {
        '@type': 'HowToStep',
        'name': 'Generate & Copy Token',
        'text': 'Click Generate Token and copy your PAT string.',
        'url': 'https://stargazer.charanmunur.in/how-to#generate-and-copy-token',
      },
      {
        '@type': 'HowToStep',
        'name': 'Export PNG or MP4',
        'text': 'Enter your repository and PAT in Stargazer Studio to render and download your 60fps video or PNG card.',
        'url': 'https://stargazer.charanmunur.in/how-to#export-png-or-mp4',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': 'https://stargazer.charanmunur.in/',
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'How to Generate',
        'item': 'https://stargazer.charanmunur.in/how-to',
      },
    ],
  },
];
---

<Layout
  title="How to Generate — Stargazer"
  description="Step-by-step guide to generating a GitHub Personal Access Token and creating custom stargazer milestone cards and 60fps videos."
  schema={howToSchemas}
>
  <HowToPage client:load />
</Layout>
