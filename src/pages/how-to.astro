---
import HowToPage from '../components/pages/HowToPage';
import ThemeToggle from '../components/ThemeToggle';
import GitHubStars from '../components/GitHubStars';
import SmoothScroll from '../components/helpers/SmoothScroll';
import '../styles/globals.css';
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/stargazer.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>How to Generate — Stargazer</title>
    <meta
      name="description"
      content="Step-by-step guide to generating a GitHub Personal Access Token and creating custom stargazer milestone cards and 60fps videos."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const savedTheme = localStorage.getItem('stargazer-theme') || 'dark';
      document.documentElement.classList[savedTheme === 'dark' ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col justify-between font-sans antialiased">
    <SmoothScroll client:load />
    <div class="fixed top-5 right-5 md:top-6 md:right-6 z-50 flex items-center gap-2.5">
      <ThemeToggle client:load />
      <GitHubStars client:load repo="CharanMunur/stargazer" />
    </div>

    <main class="flex-1 w-full pt-8 md:pt-12 pb-16">
      <HowToPage client:load />
    </main>

    <footer class="border-t border-border py-8 text-base text-muted-foreground" role="contentinfo">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-1.5 text-muted-foreground">
          <span>Designed and developed by</span>
          <a
            href="https://charanmunur.in"
            target="_blank"
            rel="noreferrer"
            class="text-foreground hover:underline font-medium transition-colors"
          >
            charanmunur
          </a>
        </div>
        <div class="flex items-center gap-6">
          <a href="/generate" class="hover:text-foreground transition-colors">Studio</a>
          <a href="/" class="hover:text-foreground transition-colors">Templates</a>
          <a
            href="https://github.com/CharanMunur/stargazer"
            target="_blank"
            rel="noreferrer"
            class="hover:text-foreground transition-colors"
          >
            GitHub
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
