---
import Layout from '../layouts/Layout.astro';
import PrivacyPage from '../components/pages/PrivacyPage';

const privacyBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': 'https://stargazer.charanmunur.in/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Privacy Policy',
      'item': 'https://stargazer.charanmunur.in/privacy',
    },
  ],
};
---

<Layout
  title="Privacy Policy — Stargazer"
  description="Stargazer Privacy Policy. Zero data collection, memory-only token handling, and client-side processing."
  schema={privacyBreadcrumbSchema}
>
  <PrivacyPage client:load />
</Layout>
