---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  id="main-footer"
  class={`border-t border-border/60 bg-background/50 text-sm text-muted-foreground pt-10 sm:pt-12 pb-8 transition-[background-color,border-color,color,opacity,transform] duration-500 ease-out opacity-0 translate-y-3 data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0 motion-reduce:transition-none motion-reduce:opacity-100 motion-reduce:translate-y-0 ${className}`}
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto px-6">
    {/* Main Top Grid */}
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-5 gap-6 sm:gap-8 lg:gap-12 pb-8 sm:pb-10">
      {/* Brand & Mission Column (Spans full width on mobile, 2 cols on md+) */}
      <div class="col-span-2 md:col-span-2 space-y-3">
        <a href="/" class="inline-flex items-center text-foreground hover:opacity-90 transition-opacity" aria-label="Stargazer Home">
          <img
            src="/stargazer-dark.svg"
            alt="Stargazer"
            class="h-10 sm:h-12 w-auto object-contain dark:block hidden shrink-0 select-none"
          />
          <img
            src="/stargazer-light.svg"
            alt="Stargazer"
            class="h-10 sm:h-12 w-auto object-contain dark:hidden block shrink-0 select-none"
          />
        </a>

        <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed max-w-sm">
          Turn your GitHub stars into living art. Generate high-definition milestone cards and 60fps MP4 loops directly in your browser with client-side rendering.
        </p>
      </div>

      {/* Navigation Column: Product */}
      <div class="col-span-1 space-y-2.5">
        <span class="text-xs sm:text-sm font-semibold tracking-tight text-foreground block">
          Product
        </span>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href="/" class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm">
              Templates
            </a>
          </li>
          <li>
            <a href="/generate" class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm">
              Studio
            </a>
          </li>
          <li>
            <a href="/how-to" class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm">
              How to Generate
            </a>
          </li>
        </ul>
      </div>

      {/* Navigation Column: Legal & Compliance */}
      <div class="col-span-1 space-y-2.5">
        <span class="text-xs sm:text-sm font-semibold tracking-tight text-foreground block">
          Legal
        </span>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href="/privacy" class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm">
              Terms of Service
            </a>
          </li>
        </ul>
      </div>

      {/* Navigation Column: Resources & Crawlers */}
      <div class="col-span-2 sm:col-span-1 space-y-2.5">
        <span class="text-xs sm:text-sm font-semibold tracking-tight text-foreground block">
          Resources
        </span>
        <ul class="space-y-2 text-xs sm:text-sm flex flex-col">
          <li>
            <a
              href="https://github.com/CharanMunur/stargazer"
              target="_blank"
              rel="noreferrer"
              class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://github.com/CharanMunur/stargazer/issues"
              target="_blank"
              rel="noreferrer"
              class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
            >
              Issues
            </a>
          </li>
          <li>
            <a
              href="/sitemap.xml"
              target="_blank"
              class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
            >
              Sitemap
            </a>
          </li>
          <li>
            <a
              href="/robots.txt"
              target="_blank"
              class="hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
            >
              robots.txt
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Row Divider */}
    <div class="pt-6 border-t border-border/50 flex flex-col sm:flex-row items-center justify-between gap-2.5 sm:gap-4 text-xs sm:text-sm text-muted-foreground text-center sm:text-left">
      <p class="leading-normal">
        &copy; {currentYear} Stargazer. Open source under MIT License.
      </p>

      <div class="flex items-center gap-1.5 leading-normal shrink-0">
        <span>Designed & developed by</span>
        <a
          href="https://charanmunur.in"
          target="_blank"
          rel="noreferrer"
          class="text-foreground hover:underline font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
        >
          CharanMunur
        </a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    const footer = document.getElementById('main-footer');
    if (!footer) return;
    if (!('IntersectionObserver' in window)) {
      footer.setAttribute('data-visible', 'true');
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            footer.setAttribute('data-visible', 'true');
            observer.disconnect();
          }
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px 40px 0px' }
    );
    observer.observe(footer);
  })();
</script>
