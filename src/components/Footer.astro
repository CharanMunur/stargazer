---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<footer class={`border-t border-border py-8 text-sm text-muted-foreground ${className}`} role="contentinfo">
  <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-1.5 text-muted-foreground">
      <span>Designed and developed by</span>
      <a
        href="https://charanmunur.in"
        target="_blank"
        rel="noreferrer"
        class="text-foreground hover:underline font-medium transition-colors"
      >
        charanmunur
      </a>
    </div>

    <div class="flex items-center gap-6 flex-wrap justify-center sm:justify-end">
      <a href="/" class="hover:text-foreground transition-colors">Templates</a>
      <a href="/generate" class="hover:text-foreground transition-colors">Studio</a>
      <a href="/how-to" class="hover:text-foreground transition-colors">How to</a>
      <a
        href="https://github.com/CharanMunur/stargazer"
        target="_blank"
        rel="noreferrer"
        class="hover:text-foreground transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://github.com/CharanMunur/stargazer/issues"
        target="_blank"
        rel="noreferrer"
        class="hover:text-foreground transition-colors"
      >
        Issues
      </a>
    </div>
  </div>
</footer>
